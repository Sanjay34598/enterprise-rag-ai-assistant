# Application Environment Variables
PROJECT_NAME="Enterprise RAG AI Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag"

# Security & JWT
JWT_SECRET="super-secret-key-change-in-production-environments"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Provider Settings
LLM_PROVIDER="ollama" # Options: ollama, openai
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OPENAI_API_KEY=""

# Embeddings & VectorStore
EMBEDDING_PROVIDER="huggingface" # Options: huggingface, openai, ollama
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_STORE_TYPE="pgvector" # Options: pgvector, faiss, chromadb
